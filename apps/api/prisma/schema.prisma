// Sho Music 2.0 — Core Database Schema
// Strong consistency required for rights, licenses, entitlements, identity.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  role          UserRole @default(LISTENER)
  territory     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  artists       Artist[]  @relation("UserArtists")
  playlists     Playlist[]
  listeningHistory ListeningEvent[]
  uploads       Track[]   @relation("UploadedBy")
  @@index([email])
  @@map("users")
}

enum UserRole {
  LISTENER
  ARTIST
  LABEL
  ADMIN
  BUSINESS
}

model Artist {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  bio         String?
  imageUrl    String?
  verified    Boolean  @default(false)
  userId      String?
  user        User?    @relation("UserArtists", fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tracks      TrackArtist[]
  albums      AlbumArtist[]
  @@index([name])
  @@map("artists")
}

model Album {
  id          String    @id @default(cuid())
  title       String
  releaseDate DateTime?
  type        AlbumType @default(ALBUM)
  artworkKey  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tracks      Track[]
  artists     AlbumArtist[]
  @@map("albums")
}

enum AlbumType {
  ALBUM
  EP
  SINGLE
  COMPILATION
}

model AlbumArtist {
  albumId  String
  artistId String
  role     String @default("primary")
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  @@id([albumId, artistId])
  @@map("album_artists")
}

model Track {
  id               String      @id @default(cuid())
  isrc             String?     @unique
  title            String
  version          String?
  durationMs       Int
  releaseDate      DateTime?
  explicit         Boolean     @default(false)
  language         String?
  copyright        String?
  publisher        String?
  label            String?
  originalObjectKey String?
  masterObjectKey   String?
  streamObjectKey   String?
  previewObjectKey  String?
  artworkObjectKey  String?
  fingerprint       String?
  status           TrackStatus @default(UPLOADED)
  rightsState      String      @default("USER_UNVERIFIED")
  albumId          String?
  album            Album?      @relation(fields: [albumId], references: [id])
  uploadedById     String?
  uploadedBy       User?       @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  artists          TrackArtist[]
  intelligence     MusicIntelligence?
  rightsRecord     RightsRecord?
  playlistTracks   PlaylistTrack[]
  listeningEvents  ListeningEvent[]
  @@index([title])
  @@index([status])
  @@index([rightsState])
  @@map("tracks")
}

enum TrackStatus {
  UPLOADED
  VALIDATING
  ANALYZING
  RIGHTS_REVIEW
  READY
  PUBLISHED
  RESTRICTED
  BLOCKED
  REMOVED
}

model TrackArtist {
  trackId  String
  artistId String
  role     String @default("primary")
  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  @@id([trackId, artistId])
  @@map("track_artists")
}

model MusicIntelligence {
  id                String   @id @default(cuid())
  trackId           String   @unique
  track             Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genres            Json
  moods             Json
  energy            Float
  tempoBpm          Float?
  key               String?
  languages         Json?
  vocalPresence     String   @default("unknown")
  instruments       Json?
  era               String?
  danceability      Float?
  acousticness      Float?
  explicitDetected  Boolean  @default(false)
  embedding         Unsupported("vector")?
  confidenceOverall Float
  modelVersion      String
  processedAt       DateTime @default(now())
  @@map("music_intelligence")
}

model RightsRecord {
  id                String   @id @default(cuid())
  assetId           String   @unique
  track             Track    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  recordingOwnerId  String?
  publishingOwnerId String?
  state             String
  commercial        Boolean  @default(false)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?
  lastReviewedAt    DateTime?
  lastReviewedBy    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  licenses          License[]
  territories       TerritoryRule[]
  @@index([state])
  @@map("rights_records")
}

model License {
  id                  String       @id @default(cuid())
  rightsRecordId      String
  rightsRecord        RightsRecord @relation(fields: [rightsRecordId], references: [id], onDelete: Cascade)
  licensorId          String
  licenseeId          String
  rightsType          String[]
  territories         String[]
  usageTypes          String[]
  startDate           DateTime
  endDate             DateTime?
  commercial          Boolean      @default(true)
  revenueConditions   String?
  reportingObligations String?
  restrictions        String[]
  contractReference   String?
  status              LicenseStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  @@index([status])
  @@map("licenses")
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}

model TerritoryRule {
  id             String       @id @default(cuid())
  rightsRecordId String
  rightsRecord   RightsRecord @relation(fields: [rightsRecordId], references: [id], onDelete: Cascade)
  territory      String
  allowed        Boolean
  reason         String?
  @@unique([rightsRecordId, territory])
  @@map("territory_rules")
}

model Playlist {
  id               String   @id @default(cuid())
  title            String
  description      String?
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic         Boolean  @default(false)
  isAiGenerated    Boolean  @default(false)
  generatedFromPrompt String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tracks           PlaylistTrack[]
  @@map("playlists")
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  @@id([playlistId, trackId])
  @@map("playlist_tracks")
}

model ListeningEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  durationMs Int?
  completed Boolean  @default(false)
  skipped   Boolean  @default(false)
  deviceId  String?
  territory String?
  context   String?
  @@index([userId, startedAt])
  @@index([trackId])
  @@map("listening_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
