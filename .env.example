# Sho Music 2.0 - Environment Example
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://sho:sho@localhost:5432/sho_music?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=shoaccess
S3_SECRET_KEY=shosecretkey
S3_BUCKET=sho-audio
S3_REGION=us-east-1

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Feature flags
ENABLE_OFFLINE=true
ENABLE_EXTERNAL_ADAPTERS=false
